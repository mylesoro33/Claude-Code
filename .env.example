# Copy to .env and fill in what you have. Empty = that feature switches off cleanly.
# Full walkthrough for every value: SETUP.md
# Song search, artwork and previews use the iTunes Search API: no key, no login.

# ---- Basics ----
COOKIE_SECURE=0
DATABASE_PATH=./data/encore.db
PORT=3000

# ---- Charts and Most Streamed ----
# Last.fm: genre tags (one genre per song) and play counts for Most Streamed.
LASTFM_API_KEY=
# Kworb: Spotify all-time stream counts for Most Streamed (no key; set 0 to turn off).
KWORB_ENABLED=1
# Billboard: leave empty to use Apple Music's free genre charts on the Charts tab.
BILLBOARD_PROVIDER=
BILLBOARD_API_KEY=
BILLBOARD_API_HOST=
