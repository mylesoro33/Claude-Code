# Copy to .env and fill in what you have. Empty = that feature switches off cleanly.
# Full walkthrough for every value: SETUP.md

# ---- Basics ----
APP_URL=http://localhost:3000
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=0
DATABASE_PATH=./data/encore.db
PORT=3000

# ---- Apple Music (MusicKit) ----
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# APPLE_PRIVATE_KEY=   (alternative: paste the .p8 contents, with \n for line breaks)

# ---- Spotify ----  redirect URI: {APP_URL}/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- YouTube Music via Google ----  redirect URI: {APP_URL}/auth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ---- SoundCloud ----  redirect URI: {APP_URL}/auth/soundcloud/callback
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# ---- Amazon Music ----  redirect URI: {APP_URL}/auth/amazon/callback
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_MUSIC_API_KEY=

# ---- Last.fm ----
LASTFM_API_KEY=

# ---- Charts ----
KWORB_ENABLED=1
# Billboard: leave empty to use Apple Music's genre charts as the current chart.
BILLBOARD_PROVIDER=
BILLBOARD_API_KEY=
BILLBOARD_API_HOST=
